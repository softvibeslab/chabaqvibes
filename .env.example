# Dynatrace tenant URL.
# Example shape only; do not commit real values.
DT_URL=https://YOUR_ENVIRONMENT_ID.apps.dynatrace.com

# Access token for Monaco.
# Required permissions depend on the resources you deploy.
# Common baseline requested for this project:
# - ReadConfig
# - WriteConfig
# - settings.read
# - settings.write
DT_TOKEN=dt0c01.YOUR_ACCESS_TOKEN

# OAuth client credentials for Dynatrace Platform / Settings 2.0 resources.
DT_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
DT_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET

